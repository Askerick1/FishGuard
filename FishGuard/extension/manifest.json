{
  "manifest_version": 3,
  "name": "FishGuard - Anti-Phishing Protection",
  "version": "1.2.0",
  "description": "Automated anti-phishing protection tailored for Azerbaijan. Protects against banking, logistics, and government lookalike websites.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "webNavigation",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://raw.githubusercontent.com/*",
    "https://hole.cert.pl/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FishGuard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "120",
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; object-src 'none'; style-src 'self'; img-src 'self'; connect-src http://127.0.0.1:8000 https://raw.githubusercontent.com https://hole.cert.pl; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "bundled",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "domains.js",
        "detector.js",
        "openphish.js",
        "links.js"
      ]
    }
  ]
}
